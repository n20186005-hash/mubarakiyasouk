{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mubarakiyasouk",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": false
}
