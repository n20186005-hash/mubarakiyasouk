---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { languages, defaultLang, t } from '../i18n/ui';
import type { Lang } from '../i18n/ui';

interface Props { title: string; description: string; path?: string; image?: string; imageAlt?: string; noindex?: boolean; jsonLd?: unknown[]; lang?: Lang; siteName?: string; }
const { title, description, path='/', image, imageAlt, noindex=false, jsonLd=[], lang=defaultLang, siteName } = Astro.props;
const langConf = languages[lang];
const site = Astro.site?.toString().replace(/\/$/, '');
const absolute = (p: string) => site ? new URL(p, `${site}/`).toString() : undefined;
const canonical = absolute(path);
const ogImage = image ? absolute(image) : undefined;
const arPath = lang === 'ar' ? path : (path.startsWith('/en') ? path.slice(3) || '/' : path);
const enPath = lang === 'en' ? path : (path === '/' ? '/en/' : '/en' + path);
const arHref = !noindex ? absolute(arPath) : undefined;
const enHref = !noindex ? absolute(enPath) : undefined;
---
<!doctype html>
<html lang={langConf.htmlLang} dir={langConf.dir}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#3a2418" />
  {canonical && <link rel="canonical" href={canonical} />}
  {arHref && <link rel="alternate" hreflang="ar" href={arHref} />}
  {enHref && <link rel="alternate" hreflang="en" href={enHref} />}
  {arHref && <link rel="alternate" hreflang="x-default" href={arHref} />}
  {noindex && <meta name="robots" content="noindex,follow" />}
  <meta property="og:type" content="website" />
  {siteName && <meta property="og:site_name" content={siteName} />}
  <meta property="og:locale" content={langConf.ogLocale} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  {ogImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png" />
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Mubarakiya" />
  {jsonLd.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
  <script is:inline src="/analytics.js"></script>
  <script is:inline>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      });
    }
  </script>
</head>
<body>
  <a class="skip" href="#content">{t(lang, 'skip')}</a>
  <Header lang={lang} />
  <main id="content"><slot /></main>
  <Footer lang={lang} />
</body>
</html>
