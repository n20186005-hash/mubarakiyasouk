---
import { defaultLang, t } from '../i18n/ui';
import type { Lang } from '../i18n/ui';
const { compact = false, lang = defaultLang } = Astro.props;
---
<a class="logo" href={lang === 'en' ? '/en/' : '/'} aria-label={t(lang, 'logo.aria')} lang={lang}>
  <svg class={compact ? 'mark compact' : 'mark'} viewBox="0 0 96 96" role="img" aria-label={t(lang, 'logo.title')}>
    <path d="M18 78V43C18 24 31 11 48 11s30 13 30 32v35" fill="none" stroke="currentColor" stroke-width="8" stroke-linecap="round"/>
    <path d="M26 78h44" stroke="currentColor" stroke-width="8" stroke-linecap="round"/>
    <path d="M48 29v11" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
    <path d="M38 43h20l-3 19H41l-3-19Z" fill="currentColor"/>
    <circle cx="48" cy="54" r="4" fill="#f2e6d0"/>
  </svg>
  {!compact && <span><strong>{t(lang, 'logo.title')}</strong><small>{t(lang, 'logo.tagline')}</small></span>}
</a>
<style>
  .logo{display:inline-flex;align-items:center;gap:.75rem;text-decoration:none;color:#3a2418}.mark{width:54px;height:54px;color:#7b4a29}.mark.compact{width:42px;height:42px}.logo span{display:grid;line-height:1.25}.logo strong{font-size:1.04rem}.logo small{font-size:.72rem;color:#765f4d;margin-top:.22rem}@media(max-width:560px){.logo small{display:none}}
</style>
