---
import { getWeather, type WeatherData } from '../lib/weather';
interface Props { lang?: 'ar' | 'en'; }
const { lang = 'ar' } = Astro.props;

const w: WeatherData | null = await getWeather(lang).catch(() => null);

const WD_AR = ['الأحد','الإثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت'];
const WD_EN = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const fmtDay = (iso: string) => {
  const d = new Date(iso + 'T00:00:00');
  const name = lang === 'ar' ? WD_AR[d.getDay()] : WD_EN[d.getDay()];
  return { name, num: d.getDate() };
};
const t = (ar: string, en: string) => (lang === 'ar' ? ar : en);
---

{w === null ? (
  <section class="section weather">
    <div class="wrap">
      <p class="eyebrow">{t('الطقس الآن', 'Weather right now')}</p>
      <h2 class="section-title">{t('حالة الطقس', 'Current conditions')}</h2>
      <p class="lead">{t('يتعذر عرض الطقس في هذه اللحظة. تفقّد لاحقاً أو راجع تطبيق الطقس المحلي قبل الزيارة.', 'Weather could not be shown right now. Check back shortly, or consult a local forecast before you visit.')}</p>
    </div>
  </section>
) : (
  <section class="section weather">
    <div class="wrap">
      <p class="eyebrow">{t('الطقس الآن', 'Weather right now')}</p>
      <h2 class="section-title">{t('الطقس في سوق المباركية', 'Weather at Souk Al-Mubarakiya')}</h2>
      <p class="lead">{t('ظروف اللحظة والتوقعات للأيام القادمة، لتخطط لزيارتك بثقة.', 'Live conditions and the coming days, so you can plan your visit with confidence.')}</p>

      <div class="wx-grid">
        <div class="wx-now card">
          <div class="wx-now-top">
            <span class="wx-icon">{w.current.icon}</span>
            <div>
              <div class="wx-temp">{w.current.temp}°</div>
              <div class="wx-desc">{lang === 'ar' ? w.current.descAr : w.current.descEn}</div>
            </div>
          </div>
          <dl class="wx-stats">
            <div><dt>{t('الإحساس', 'Feels like')}</dt><dd>{w.current.feels}°</dd></div>
            <div><dt>{t('الرطوبة', 'Humidity')}</dt><dd>{w.current.humidity}%</dd></div>
            <div><dt>{t('الرياح', 'Wind')}</dt><dd>{t(`الدرجة ${w.current.windLevel}`, `level ${w.current.windLevel}`)} · {w.current.windKmh} km/h</dd></div>
            <div><dt>{t('احتمال المطر', 'Rain chance')}</dt><dd>{w.current.precipProb}%</dd></div>
            <div><dt>{t('الأشعة فوق البنفسجية', 'UV index')}</dt><dd>{w.current.uv}</dd></div>
          </dl>
        </div>

        <div class="wx-forecast card">
          <h3>{t('الأيام القادمة', 'Coming days')}</h3>
          <ul class="wx-days">
            {w.days.map((d) => {
              const f = fmtDay(d.date);
              return (
                <li>
                  <span class="wx-d-name">{f.name}</span>
                  <span class="wx-d-icon">{d.icon}</span>
                  <span class="wx-d-desc">{lang === 'ar' ? d.descAr : d.descEn}</span>
                  <span class="wx-d-temp"><b>{d.tmax}°</b> / {d.tmin}°</span>
                  <span class="wx-d-precip">{d.precip}%</span>
                </li>
              );
            })}
          </ul>
        </div>
      </div>

      {w.advice.risk && (
        <div class="wx-risk">
          <span class="wx-risk-ic">⚠️</span>
          <span>{lang === 'ar' ? w.advice.risk.ar : w.advice.risk.en}</span>
        </div>
      )}
      <div class="wx-advice">
        {w.advice.outfit.length > 0 && (
          <div class="wx-adv-card">
            <h4>{t('ما ترتديه', 'What to wear')}</h4>
            <ul>{w.advice.outfit.map((x) => <li>{lang === 'ar' ? x.ar : x.en}</li>)}</ul>
          </div>
        )}
        {w.advice.plan.length > 0 && (
          <div class="wx-adv-card">
            <h4>{t('ترتيب الزيارة', 'How to plan')}</h4>
            <ul>{w.advice.plan.map((x) => <li>{lang === 'ar' ? x.ar : x.en}</li>)}</ul>
          </div>
        )}
        {w.advice.items.length > 0 && (
          <div class="wx-adv-card">
            <h4>{t('ما تحمله معك', 'What to bring')}</h4>
            <ul>{w.advice.items.map((x) => <li>{lang === 'ar' ? x.ar : x.en}</li>)}</ul>
          </div>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .weather { background: #fbf6ec; }
  .wx-grid { display:grid; grid-template-columns: 1fr 1.25fr; gap:18px; margin-top:30px; }
  .wx-now, .wx-forecast { padding:26px; border-radius:26px; }
  .wx-now-top { display:flex; align-items:center; gap:18px; }
  .wx-icon { font-size:3.4rem; line-height:1; }
  .wx-temp { font-size:3rem; font-weight:900; color:#3a2418; line-height:1; }
  .wx-desc { color:#5d4b3d; font-weight:700; }
  .wx-stats { display:grid; grid-template-columns:1fr 1fr; gap:12px 18px; margin:22px 0 0; }
  .wx-stats div { display:flex; flex-direction:column; gap:2px; border-top:1px solid rgba(74,45,27,.14); padding-top:10px; }
  .wx-stats dt { font-size:.74rem; color:#806d5c; font-weight:800; }
  .wx-stats dd { margin:0; font-size:1rem; color:#3a2418; font-weight:700; }
  .wx-forecast h3 { margin:0 0 14px; font-size:1.2rem; color:#3a2418; }
  .wx-days { list-style:none; margin:0; padding:0; display:grid; gap:8px; }
  .wx-days li { display:grid; grid-template-columns: 2.4rem 1.6rem 1fr auto 2.4rem; align-items:center; gap:10px; padding:9px 10px; border-radius:14px; background:rgba(255,255,255,.6); font-size:.9rem; }
  .wx-d-name { font-weight:800; color:#3a2418; }
  .wx-d-icon { font-size:1.2rem; text-align:center; }
  .wx-d-desc { color:#5d4b3d; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .wx-d-temp { color:#3a2418; font-weight:700; white-space:nowrap; }
  .wx-d-precip { color:#855531; font-weight:800; text-align:right; }
  .wx-risk { display:flex; gap:10px; align-items:flex-start; margin-top:20px; padding:14px 16px; border-radius:16px; background:rgba(170,60,40,.13); color:#6e2b1c; font-weight:700; font-size:.95rem; }
  .wx-risk-ic { flex:none; }
  .wx-advice { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:12px; margin-top:14px; }
  .wx-adv-card { background:rgba(199,155,85,.14); border-radius:18px; padding:16px 18px; }
  .wx-adv-card h4 { margin:0 0 10px; font-size:.95rem; color:#3a2418; letter-spacing:.01em; }
  .wx-adv-card ul { margin:0; padding-inline-start:1.1rem; display:grid; gap:7px; color:#4a3527; font-size:.92rem; }
  html[dir="rtl"] .wx-adv-card ul { padding-inline-start:1.4rem; }
  html[dir="ltr"] .wx-days li { grid-template-columns: 2.4rem 1.6rem 1fr auto 2.4rem; }
  @media (max-width: 820px){ .wx-grid{ grid-template-columns:1fr; } .wx-days li{ grid-template-columns: 2.2rem 1.4rem 1fr auto 2.2rem; } }
  @media (max-width: 520px){ .wx-d-desc{ display:none; } }
</style>
