---
import Logo from './Logo.astro';
import { defaultLang, t } from '../i18n/ui';
import type { Lang } from '../i18n/ui';
const { lang = defaultLang } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';
---
<footer class="footer">
  <div class="wrap">
    <div class="top">
      <Logo lang={lang} />
      <div class="links"><a href={prefix + '/privacy/'}>{t(lang, 'footer.privacy')}</a><a href={prefix + '/terms/'}>{t(lang, 'footer.terms')}</a><a href={prefix + '/cookies/'}>{t(lang, 'footer.cookies')}</a></div>
    </div>
    <div class="rule"></div>
    <div class="notes">
      <p>{t(lang, 'footer.note1')}</p>
      <p>{t(lang, 'footer.note2')}</p>
      <p>{t(lang, 'footer.note3')}</p>
      <p>{t(lang, 'footer.copyright')}</p>
    </div>
  </div>
</footer>
<style>
  .footer{padding:50px 0 34px;background:#21160f;color:#eadcc7}.top{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;padding-bottom:26px}.top :global(.logo){color:#eadcc7!important}.top :global(.mark){color:#c79b55!important}.top :global(.logo small){color:#bca78d!important}.links{display:flex;flex-wrap:wrap;gap:1.2rem}.links a{font-size:.88rem;text-decoration:none}.notes{padding-top:24px;display:grid;grid-template-columns:repeat(2,1fr);gap:8px 34px}.notes p{font-size:.8rem;color:#bda990;margin:.15rem 0}@media(max-width:760px){.top{align-items:flex-start;flex-direction:column}.notes{grid-template-columns:1fr}}
</style>
