---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import WeatherSection from '../components/WeatherSection.astro';
import GuideSections from '../components/GuideSections.astro';
import { SITE_NAME, SITE_NAME_AR } from '../data/site';

const site = Astro.site?.toString().replace(/\/$/, '');
const pageUrl = site ? `${site}/` : undefined;
const attractionId = site ? `${site}/#attraction` : '#attraction';
const websiteId = site ? `${site}/#website` : '#website';
const heroImage = site ? `${site}/images/souk-al-mubarakiya-night.jpg` : '/images/souk-al-mubarakiya-night.jpg';
const address = {
  '@type': 'PostalAddress',
  streetAddress: 'المباركية، شارع سوق الغربللي',
  addressLocality: 'مدينة الكويت',
  addressRegion: 'محافظة العاصمة',
  addressCountry: 'KW'
};
const numericParts = (text: string) => text.split(/(\d{2}:\d{2}[–-]\d{2}:\d{2}|\d+\.\d+,\s*\d+\.\d+)/).map((value, index) => ({value, numeric: index % 2 === 1}));

const faq = [
  ['أين يقع سوق المباركية؟','يقع سوق المباركية في حي المباركية بمدينة الكويت على شارع سوق الغربللي، في محافظة العاصمة بدولة الكويت. أقرب نقطة مرجعية: نقطة الخريطة 29.373827, 47.972932.'],
  ['هل توجد خريطة لموقع سوق المباركية وما نقطة الخريطة؟','نعم، يظهر السوق على خرائط غوغل عند البحث عن «سوق المباركية، شارع سوق الغربللي» في مدينة الكويت. نقطة الخريطة (Map point) هو 29.373827, 47.972932، ويمكن فتح الرابط المباشر للخريطة من زر «الاتجاهات على الخريطة» أعلى الصفحة للوصول سيرًا أو بسيارة أجرة إلى حافة السوق.'],
  ['هل يحتاج سوق المباركية إلى تذكرة دخول؟','هذه منطقة أسواق وليست معلمًا واحدًا بتذكرة موحدة. اسأل الجهة المعنية عن أي رسوم قبل استخدام الخدمة؛ المشتريات والطعام منفصلان.'],
  ['ما الوقت الأنسب لزيارة سوق المباركية؟','تكون الأجواء ألطف عادة في الأشهر المعتدلة، كما أن فترة ما بعد العصر والمساء مناسبة لمن يريد أجواء السوق النشطة. الزيارة الصباحية أنسب غالبًا لمن يفضّل هدوءًا نسبيًا.'],
  ['كم تستغرق الزيارة؟','يمكن تخصيص نحو ساعة ونصف إلى ثلاث ساعات لاستكشاف الممرات والأسواق المتخصصة وتناول وجبة أو مشروب. المدة تقديرية وتختلف حسب الاهتمامات.'],
  ['كيف أصل من مطار الكويت الدولي؟','يمكن استخدام سيارة أجرة مرخصة من المطار، أو خطوط النقل العام المتجهة نحو مركز المدينة ثم متابعة الطريق سيرًا أو بسيارة أجرة قصيرة. راجع الجداول الرسمية قبل الانطلاق لأنها قابلة للتغيير.'],
  ['هل توجد مواقف سيارات؟','حدد موقفًا يعمل حاليًا قبل الانطلاق، وتحقق من المدخل والأسعار ومسار المشي إلى السوق؛ لا يوثق هذا الدليل مرفقًا بعينه.'],
  ['ما هي ساعات عمل سوق المباركية ومتى يفتح؟','تعرض قائمة خرائط Google التي روجعت في 23 أكتوبر 2026 ساعات 08:00–22:00 يوميًا (من الاثنين إلى الأحد) لمنطقة السوق العامة. هذه الساعات إرشادية وقد تختلف بحسب المحل أو الموسم أو المناسبة، لذلك يُستحسن مراجعة اللافتات المحلية أو القنوات الرسمية عند الوصول، خصوصًا في الأعياد والمناسبات.'],
  ['هل توجد مطاعم وأكلات مشهورة في سوق المباركية؟','يُعرف السوق بأجواء الأكل الشعبي: المشويات وأطباق الأرز والمأكولات البحرية والحلويات والتمور والقهوة. هذا دليل للسوق كله، وليس لمطعم بعينه. راجع قائمة الطعام والأسعار الحالية لدى البائع قبل الطلب.'],
  ['هل توجد دورات مياه وخدمات للزوار؟','اسأل عند الوصول عن أقرب دورة مياه مفتوحة ومسار خالٍ من الدرج. لم يتحقق هذا الدليل من تشغيل المرافق المنفردة أو ساعاتها أو إمكانية الوصول إليها.'],
  ['هل السوق مناسب لمستخدمي الكراسي المتحركة؟','بعض الممرات واسعة وممهدة، بينما قد تكون أجزاء السوق التاريخية مزدحمة أو ذات انتقالات غير متساوية. من الأفضل اختيار المداخل الأوسع وتجنب ساعات الذروة عند الحاجة إلى حركة أسهل.'],
  ['ما الذي يميز سوق المباركية تاريخيًا؟','المنطقة جزء من شبكة أسواق قديمة في قلب مدينة الكويت، وارتبطت بتجارة الغذاء والعطور والأقمشة والأسلحة والبشوت وغيرها. تصف جامعة الكويت شبكة من الأسواق التاريخية؛ لا ينبغي تعميم تاريخ معلم منفرد على السوق كله.']
];

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': attractionId,
  ...(pageUrl ? { url: pageUrl } : {}),
  name: 'سوق المباركية',
  alternateName: ['Souk Al-Mubarakiya','Al-Mubarakiya Old Souk','Kuwait City Souk Al-Mubarakiya','مطعم شباب المباركية'],
  description: 'دليل زوار شامل لسوق المباركية في مدينة الكويت، محافظة العاصمة، دولة الكويت: التاريخ، الموقع، أوقات الزيارة، المواصلات، المرافق والمعالم القريبة.',
  image: [heroImage],
  address,
  geo: { '@type':'GeoCoordinates', latitude: 29.3738265, longitude: 47.9729324 },
  containedInPlace: { '@type':'City', name:'مدينة الكويت', containedInPlace:{ '@type':'Country', name:'دولة الكويت' } },
  hasMap: 'https://maps.app.goo.gl/Unad47yFEGSrn79r6',
};
const webPageSchema = {
  '@context':'https://schema.org',
  '@type':'WebPage',
  ...(pageUrl ? { url: pageUrl } : {}),
  name:'دليل سوق المباركية في مدينة الكويت',
  inLanguage:'ar-KW',
  dateModified:'2026-10-23',
  about:{ '@id': attractionId },
  mainEntity:{ '@id': attractionId },
  isPartOf:{ '@type':'WebSite', '@id':websiteId, ...(pageUrl ? { url:pageUrl } : {}), name:'دليل سوق المباركية' }
};
const faqSchema = {
  '@context':'https://schema.org', '@type':'FAQPage', mainEntity: faq.map(([q,a]) => ({ '@type':'Question', name:q, acceptedAnswer:{'@type':'Answer',text:a} }))
};

const photos = [
  {
    src:'/images/souk-al-mubarakiya-night.jpg',
    alt:'سوق المباركية - منظر رئيسي في مدينة الكويت، الكويت، ليلًا',
    credit:'تصوير: زيرون — ترخيص المشاع الإبداعي نَسب المصنف 4.0'
  },
  {
    src:'/images/souk-al-mubarakiya-day.jpg',
    alt:'سوق المباركية - مشهد نهاري من ممرات السوق في مدينة الكويت',
    credit:'تصوير: عزيز1005 — ملكية عامة'
  }
];
const mapsUrl = 'https://maps.app.goo.gl/Unad47yFEGSrn79r6';
const mapsEmbedSrc = 'https://www.google.com/maps?q=29.3738265,47.9729324&output=embed';
---
<BaseLayout
  title="سوق المباركية في الكويت | الموقع وأوقات العمل ودليل الزيارة"
  description="خطط لزيارة سوق المباركية في مدينة الكويت: خريطة الموقع وساعات مؤرخة، الأسواق التاريخية والطعام وتوقعات الطقس وما ينبغي التحقق منه قبل الذهاب."
  path="/"
  image="/images/souk-al-mubarakiya-night.jpg"
  imageAlt="سوق المباركية في مدينة الكويت — ممرات السوق التاريخية ليلًا"
  lang="ar"
  siteName={SITE_NAME_AR}
  jsonLd={[attractionSchema, webPageSchema, faqSchema]}
>
  <section class="hero geometric">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">مدينة الكويت · القبلة · قلب الأسواق التاريخية</p>
        <h1>سوق المباركية (مدينة الكويت)</h1>
        <p class="hero-lead">ممرات مظللة، رائحة البهارات والقهوة، واجهات خشبية، وأسواق متخصصة تحفظ صورة من الحياة التجارية القديمة في الكويت.</p>
        <div class="facts" aria-label="معلومات سريعة">
          <span><b><bdi dir="ltr">08:00–22:00</bdi></b><small>خرائط Google · 23 أكتوبر 2026؛ تختلف المحلات</small></span>
          <span><b><bdi dir="ltr">4.4 / 5</bdi></b><small>خرائط Google: 26,529 مراجعة · 23 أكتوبر 2026</small></span>
          <span><b><bdi dir="ltr">29.373827, 47.972932</bdi></b><small>نقطة الخريطة في مدينة الكويت</small></span>
        </div>
        <div class="actions"><a class="primary" href="#visit">خطط زيارتك</a><a class="secondary" href={mapsUrl} rel="noopener noreferrer">الاتجاهات على الخريطة</a></div>
      </div>
      <figure class="arch hero-photo">
        <img src={photos[0].src} alt={photos[0].alt} width="960" height="656" loading="eager" fetchpriority="high" />
        <figcaption>{photos[0].credit} · <a href="https://commons.wikimedia.org/wiki/File:Kuwait_City_Souq_al-Mubarakeya_at_Night_01.jpg">Wikimedia Commons</a> · <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a> · 3 ديسمبر 2022؛ تغيير الحجم وقص العرض.</figcaption>
      </figure>
    </div>
  </section>

  <section class="identity-strip">
    <div class="wrap identity-grid">
      <div><small>الاسم</small><strong>سوق المباركية</strong></div>
      <div><small>الموقع</small><strong>المباركية، شارع سوق الغربللي، مدينة الكويت</strong></div>
      <div><small>الإحداثيات</small><strong dir="ltr">29.373827, 47.972932</strong></div>
      <div><small>الطبيعة</small><strong>سوق تراثي ومقصد للزوار</strong></div>
    </div>
  </section>

  <WeatherSection lang="ar">
    <div class="wrap"><p class="eyebrow">الطقس الآن</p><h2 class="section-title">الطقس في سوق المباركية</h2></div>
  </WeatherSection>

  <section id="about" class="section">
    <div class="wrap about-grid">
      <div>
        <p class="eyebrow">عن الوجهة</p>
        <h2 class="section-title">عن سوق المباركية</h2>
        <p class="lead">مرحبًا بكم في <strong>سوق المباركية</strong>، الذي يُعرف على نطاق واسع بوصفه <strong>قلب الأسواق التاريخية في مدينة الكويت</strong>. يقع هذا الوجهة في قلب العاصمة، في <strong>محافظة العاصمة</strong>، <strong>دولة الكويت</strong>، ويشكّل محورًا رئيسيًا للزوار القادمين إلى المنطقة.</p>
        <div class="crumb" aria-label="التسلسل الجغرافي"><span>سوق المباركية</span><i>←</i><span>مدينة الكويت</span><i>←</i><span>محافظة العاصمة</span><i>←</i><span>دولة الكويت</span></div>
        <p class="nearby-lead">عند زيارة <strong>سوق المباركية</strong> يمكن للزوار استكشاف معالم تاريخية ومناطق جذب قريبة، منها <strong>كشك الشيخ مبارك</strong> و<strong>المسجد الكبير</strong>، إضافة إلى قصر السيف ومتحف الكويت الوطني وبيت السدو.</p>
      </div>
      <aside class="card loc-card">
        <h3>الموقع وساعات الزيارة</h3>
        <dl>
          <dt>العنوان</dt><dd dir="ltr">Al-Mubarakiya, Gharabally Souq St, Kuwait City</dd>
          <dt>ساعات الزيارة</dt><dd><bdi dir="ltr">08:00–22:00</bdi> · خرائط Google، 23 أكتوبر 2026؛ تختلف المحلات والعطلات.</dd>
          <dt>نقطة الخريطة</dt><dd dir="ltr">29.373827, 47.972932</dd>
          <dt>التقييم</dt><dd dir="ltr">4.4 / 5 (26,529)</dd>
        </dl>
        <a class="loc-link" href={mapsUrl} rel="noopener noreferrer">الاتجاهات على خرائط غوغل ↗</a>
      </aside>
    </div>
  </section>

  <section id="history" class="section">
    <div class="wrap history-grid">
      <div>
        <p class="eyebrow">هوية المكان</p>
        <h2 class="section-title">تاريخ سوق المباركية وأهميته</h2>
        <p class="lead">سوق ليس مبنى واحدًا، بل ذاكرة تجارية متشابكة — تصف المصادر الأكاديمية والرسمية المباركية بوصفها جزءًا من قلب الكويت القديم وشبكة من الأسواق المتخصصة. وتفيد جامعة الكويت بأن أسواق المنطقة تمتد جذورها إلى أكثر من 180 عامًا، مع أكثر من عشرين سوقًا تخصصيًا عُرفت بمهن وسلع مختلفة.</p>
        <div class="timeline">
          <article><b>قبل العصر النفطي</b><p>تشكّلت في المنطقة أسواق للحوم والخضار والحلوى والبشوت والسلاح والمناخ وغيرها، وكانت نقطة تبادل يومية بين أهل المدينة والتجار.</p></article>
          <article><b>معالم تاريخية</b><p>ترتبط المعالم المنفردة بتاريخ منطقة الأسواق الأوسع؛ ولا تؤرخ وحدها نشأة السوق كله.</p></article>
          <article><b>منطقة الأسواق</b><p>تربط جامعة الكويت شيوع اسم المنطقة في فترة متأخرة بانتقال المدرسة المباركية قرب السوق.</p></article>
          <article><b>نحو 1969–1970</b><p>شهدت المنطقة أعمال تنظيم وتطوير حافظت على طابع الأسواق وممراتها التراثية بدل تحويلها إلى مركز تجاري حديث مغلق.</p></article>
          <article><b>2022 وما بعده</b><p>أصاب حريق جزءًا من أقدم النطاقات التاريخية، ثم أعاد النقاش حول الحماية والترميم أهمية توثيق المباني والهوية العمرانية.</p></article>
        </div>
      </div>
      <div>
        <figure class="arch side-photo"><img src={photos[1].src} alt={photos[1].alt} loading="lazy" width="960" height="720" /><figcaption>{photos[1].credit} · <a href="https://commons.wikimedia.org/wiki/File:Elmubarakiya-market-kuwait.jpg">Wikimedia Commons · 2008</a></figcaption></figure>
        <aside class="source-note card"><strong>كيف نتحقق من الرواية؟</strong><p>نفرّق بين تاريخ المعالم الفردية وتاريخ شبكة الأسواق، ونقارن بين مصادر حكومية وأكاديمية بدل تكرار تواريخ شائعة بلا سياق.</p></aside>
      </div>
    </div>
  </section>

  <section class="section dark">
    <div class="wrap">
      <p class="eyebrow">قراءة السوق</p><h2 class="section-title">ما الذي ستراه في الممرات؟</h2>
      <div class="market-grid">
        <article><span>01</span><h3>الأسواق المتخصصة</h3><p>تاريخيًا عُرفت أجزاء من المباركية بأسماء مرتبطة بالسلع والحرف، مثل أسواق البشوت والحلوى واللحم والخضار والسلاح والمناخ.</p></article>
        <article><span>02</span><h3>الظل والخشب</h3><p>الممرات المسقوفة والعناصر الخشبية ليست مجرد ديكور؛ إنها استجابة محلية للشمس والحرارة وتمنح السوق هويته العمرانية.</p></article>
        <article><span>03</span><h3>الغذاء والعطر</h3><p>البهارات والتمور والقهوة والعطور والأطعمة المحلية جزء أساسي من التجربة الحسية للمكان، من دون حاجة إلى حصر الزيارة في متجر بعينه.</p></article>
        <article><span>04</span><h3>المعالم المدنية</h3><p>قرب الأسواق توجد شواهد على تاريخ الإدارة والتعليم والحياة العامة، وفي مقدمتها كشك الشيخ مبارك وما تبقى من ذاكرة المدينة القديمة.</p></article>
      </div>
    </div>
  </section>

  <section id="visit" class="section">
    <div class="wrap">
      <p class="eyebrow">خطة عملية</p><h2 class="section-title">قبل أن تذهب</h2>
      <div class="planning-grid">
        <article class="card"><h3>الدخول والتكاليف</h3><p>السوق منطقة تضم باعة مستقلين. اسأل عن ثمن الخدمة قبل استخدامها؛ الطعام والمشتريات والمعالم المنفصلة لها ترتيباتها الخاصة.</p></article>
        <article class="card"><h3>أفضل وقت</h3><p>تكون الأشهر المعتدلة أكثر راحة للمشي. المساء يمنح أجواء أكثر حيوية وإضاءة، بينما تسمح الزيارة الصباحية عادة باستكشاف أهدأ نسبيًا.</p></article>
        <article class="card"><h3>مدة مقترحة</h3><p>خطط لنحو ساعة ونصف إلى ثلاث ساعات. أضف وقتًا إذا كنت مهتمًا بالتاريخ أو الطعام أو المشي إلى المعالم العامة القريبة.</p></article>
        <article class="card"><h3>الملابس والسلوك</h3><p>اختر ملابس مريحة ومحتشمة وحذاء مناسبًا للمشي. احترم خصوصية الباعة والزوار عند التصوير، واطلب الإذن عند تصوير أشخاص عن قرب.</p></article>
      </div>
    </div>
  </section>

  <section id="transport" class="section sand">
    <div class="wrap">
      <p class="eyebrow">تفاصيل الوصول</p><h2 class="section-title">الموقع وطرق الوصول إلى سوق المباركية في مدينة الكويت</h2>
      <p class="lead">من المطار، بالحافلة، بسيارة الأجرة أو بالسيارة — يقع السوق في حي المباركية بوسط مدينة الكويت على شارع سوق الغربللي، ونقطة الخريطة <bdi dir="ltr">29.373827, 47.972932</bdi>.</p>
      <div class="transport-grid">
        <article><b>01</b><div><h3>من مطار الكويت الدولي</h3><p>اسأل مكتب النقل في المطار عن خيارات سيارات الأجرة المرخصة والحافلات الحالية إلى وسط مدينة الكويت. أكد السعر والوجهة قبل المغادرة؛ لا يوثق هذا الدليل خدمة مباشرة من المطار إلى السوق.</p></div></article>
        <article><b>02</b><div><h3>الحافلات العامة</h3><p>راجع المسار والجدول الحاليين لدى مشغل النقل بحسب نقطة انطلاقك. أكد المحطة ومسار المشي المتبقي قبل الركوب؛ لا نضمن رقم خط معين.</p></div></article>
        <article><b>03</b><div><h3>سيارات الأجرة</h3><p>استخدم سيارات الأجرة المرخصة أو نقاط الركوب المعروفة، واطلب تطبيق العداد أو السعر النظامي المعمول به. الوصول إلى حافة منطقة السوق غالبًا أسهل من محاولة الدخول إلى الممرات الداخلية.</p></div></article>
        <article><b>04</b><div><h3>بالسيارة الخاصة</h3><p>استهدف مرافق المواقف العامة في نطاق وسط المدينة، ثم أكمل المسافة القصيرة سيرًا. في ساعات المساء والعطلات، اترك هامشًا زمنيًا للبحث عن موقف والخروج من المنطقة.</p></div></article>
      </div>
      <div class="card" style="padding:26px;border-radius:26px;margin-top:18px">
        <h3 style="margin-top:0;color:#3a2418">نصائح عملية للوصول</h3>
        <ul style="margin:0;color:#685647;display:grid;gap:8px;padding-inline-start:1.1rem">
          <li>حدّد وجهتك في تطبيق الخرائط باسم «سوق المباركية، شارع سوق الغربللي» لتجنّب الخلط مع أسواق أخرى.</li>
          <li>من المطار: توجّه أولًا إلى وسط مدينة الكويت، ثم أكمل سيرًا أو بسيارة أجرة قصيرة إلى حافة السوق.</li>
          <li>بالحافلة: أكد المحطة المناسبة ومسار المشي لدى المشغل قبل الركوب.</li>
          <li>بسيارة الأجرة: اطلب الإنزال عند مدخل السوق لا داخل الممرات الضيقة.</li>
          <li>راجع الجداول والتعرفات الرسمية في يوم الزيارة؛ فقد تتغير.</li>
        </ul>
      </div>
      <div class="map-frame card"><iframe src={mapsEmbedSrc} width="600" height="450" style="border:0;" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin" title="خريطة موقع سوق المباركية في مدينة الكويت"></iframe></div>
    </div>
  </section>

  <section id="facilities" class="section">
    <div class="wrap">
      <p class="eyebrow">احتياجات الزائر</p><h2 class="section-title">الخدمات والمرافق حول السوق</h2>
      <p class="lead">نذكر أنواع الخدمات فقط للحفاظ على حياد الدليل وعدم تحويله إلى صفحة إعلانية. توفر الخدمة وساعاتها قد تتغير، لذلك راجع اللافتات المحلية عند الوصول.</p>
      <div class="facility-grid">
        <article><i>🚻</i><h3>دورات المياه</h3><p>اسأل عن أقرب دورة مياه مفتوحة ومدخل خالٍ من الدرج. لا نوثق مرفقًا منفردًا هنا.</p></article>
        <article><i>🅿️</i><h3>مواقف السيارات</h3><p>تحقق من مدخل الموقف المختار وساعاته ورسومه ومسار المشاة قبل الاعتماد عليه.</p></article>
        <article><i>🍽️</i><h3>الطعام</h3><p>مطاعم شعبية، مشويات، أطباق أرز، مأكولات بحرية، خبز، حلويات وتمور ومقاهي وشاي.</p></article>
        <article><i>🛏️</i><h3>الإقامة</h3><p>اختر الإقامة بحسب معلوماتها الحالية، وتحقق من مسار المشي أو وصلة النقل التي تحتاجها.</p></article>
        <article><i>🛒</i><h3>المواد اليومية</h3><p>تأكد مباشرة من ساعات المحل إذا كنت تحتاج سلعة أو خدمة أساسية معينة.</p></article>
        <article><i>⛽</i><h3>الوقود والشحن</h3><p>حدد نقطة وقود أو شحن تعمل حاليًا قبل السفر، وتحقق من توافق المركبة؛ لا يوثق هذا الدليل نقطة بعينها.</p></article>
        <article><i>💳</i><h3>الدفع والصراف</h3><p>اسأل البائع عن طرق الدفع المقبولة قبل الطلب أو الشراء، ولا تعتمد على توفر جهاز صراف معين.</p></article>
        <article><i>🕌</i><h3>أماكن الصلاة</h3><p>راجع معلومات دخول المسجد أو المصلى المعني واحترم أوقات الصلاة.</p></article>
        <article><i>➕</i><h3>الصيدلية والإسعافات</h3><p>إذا احتجت صيدلية أو خدمة طبية، حدد جهة مفتوحة مسبقًا؛ لا يوثق هذا الدليل نقطة إسعاف.</p></article>
        <article><i>♿</i><h3>سهولة الحركة</h3><p>تحقق مسبقًا من المدخل والمسار المناسبين لاحتياجاتك. قد يؤثر الزحام ونوع الأرضية والدرج في الوصول.</p></article>
      </div>
    </div>
  </section>

  <section class="section dark food">
    <div class="wrap split">
      <div><p class="eyebrow">حول المائدة</p><h2 class="section-title">ماذا تأكل من دون قوائم تجارية؟</h2><p class="lead">تعامل مع المباركية كمنطقة نكهات لا كقائمة مطاعم. ابحث عن الأنواع التي تعبّر عن المطبخ المحلي وتناسب ميزانيتك واحتياجاتك الغذائية.</p></div>
      <div class="chips"><span>أرز ولحوم على الطريقة الكويتية</span><span>مشويات</span><span>مأكولات بحرية</span><span>خبز محلي</span><span>حلويات وتمور</span><span>قهوة وشاي</span><span>بهارات وأعشاب</span></div>
    </div>
  </section>

  <GuideSections lang="ar" />

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">في المحيط القريب</p><h2 class="section-title">معالم ومناطق جذب حول سوق المباركية</h2>
      <p class="lead">معالم عامة تكمل قراءة وسط مدينة الكويت ويمكن الوصول إليها سيرًا من منطقة الأسواق.</p>
      <div class="nearby-grid">
        <article class="card"><h3>كشك الشيخ مبارك</h3><p>معلم تاريخي داخل نطاق المباركية يرتبط بالإدارة والحياة العامة في عهد الشيخ مبارك الصباح، ويُنظر إليه كمعلم منفرد ضمن تاريخ منطقة الأسواق الأوسع.</p></article>
        <article class="card"><h3>المسجد الكبير</h3><p>معلم ديني ومعماري بارز في مركز مدينة الكويت. راعِ أوقات الصلاة ومتطلبات الدخول والملابس عند الزيارة.</p></article>
        <article class="card"><h3>قصر السيف ومحيطه</h3><p>منطقة ذات أهمية سياسية وعمرانية على الواجهة الحضرية القديمة. بعض الأجزاء ليست مرفقًا سياحيًا مفتوحًا، لذلك تُشاهد من الأماكن العامة المسموح بها.</p></article>
        <article class="card"><h3>متحف الكويت الوطني وبيت السدو</h3><p>مؤسسات ثقافية تساعد على وضع السوق ضمن سياق أوسع للحياة البحرية والبدوية والحرفية في الكويت. تحقق من ساعات الزيارة الرسمية مسبقًا.</p></article>
      </div>
    </div>
  </section>

  <section id="faq" class="section sand">
    <div class="wrap faq-wrap">
      <div><p class="eyebrow">إجابات سريعة</p><h2 class="section-title">أسئلة شائعة عن سوق المباركية</h2><p class="lead">المعلومات التشغيلية تتغير. عند تعارض هذه الصفحة مع إعلان رسمي حديث، اتبع الإعلان الرسمي.</p></div>
