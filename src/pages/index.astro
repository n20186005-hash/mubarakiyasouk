---
import BaseLayout from '../layouts/BaseLayout.astro';

const site = Astro.site?.toString().replace(/\/$/, '');
const pageUrl = site ? `${site}/` : undefined;
const entityId = pageUrl ? `${pageUrl}#souq-al-mubarakiya` : '#souq-al-mubarakiya';
const websiteId = site ? `${site}/#website` : '#website';
const address = {
  '@type': 'PostalAddress',
  streetAddress: 'المباركية، شارع سوق الغربللي',
  addressLocality: 'مدينة الكويت',
  addressCountry: 'KW'
};
const faq = [
  ['هل يحتاج سوق المباركية إلى تذكرة دخول؟','الدخول إلى منطقة السوق العامة لا يتطلب تذكرة. المشتريات أو بعض الأنشطة والخدمات المنفصلة لها تكاليفها الخاصة.'],
  ['ما الوقت الأنسب لزيارة سوق المباركية؟','تكون الأجواء ألطف عادة في الأشهر المعتدلة، كما أن فترة ما بعد العصر والمساء مناسبة لمن يريد أجواء السوق النشطة. الزيارة الصباحية أنسب غالبًا لمن يفضّل هدوءًا نسبيًا.'],
  ['كم تستغرق الزيارة؟','يمكن تخصيص نحو ساعة ونصف إلى ثلاث ساعات لاستكشاف الممرات والأسواق المتخصصة وتناول وجبة أو مشروب. المدة تقديرية وتختلف حسب الاهتمامات.'],
  ['كيف أصل من مطار الكويت الدولي؟','يمكن استخدام سيارة أجرة مرخصة من المطار، أو خطوط النقل العام المتجهة نحو مركز المدينة ثم متابعة الطريق سيرًا أو بسيارة أجرة قصيرة. راجع الجداول الرسمية قبل الانطلاق لأنها قابلة للتغيير.'],
  ['هل توجد مواقف سيارات؟','توجد مرافق مواقف عامة ومتعددة الطوابق في نطاق وسط مدينة الكويت حول منطقة الأسواق. يزداد الضغط في المساء والعطلات، لذلك يُفضّل تخصيص وقت إضافي للعثور على موقف.'],
  ['هل توجد دورات مياه وخدمات للزوار؟','توجد خدمات عامة ضمن نطاق السوق والمرافق المحيطة، لكن ساعات التشغيل وسهولة الوصول قد تختلف. يُستحسن الاستفسار ميدانيًا عند الوصول.'],
  ['هل السوق مناسب لمستخدمي الكراسي المتحركة؟','بعض الممرات واسعة وممهدة، بينما قد تكون أجزاء السوق التاريخية مزدحمة أو ذات انتقالات غير متساوية. من الأفضل اختيار المداخل الأوسع وتجنب ساعات الذروة عند الحاجة إلى حركة أسهل.'],
  ['ما الذي يميز سوق المباركية تاريخيًا؟','المنطقة جزء من شبكة أسواق قديمة في قلب مدينة الكويت، وارتبطت بتجارة الغذاء والعطور والأقمشة والأسلحة والبشوت وغيرها. يرتبط عام 1897 بكشك الشيخ مبارك، وليس بالضرورة بتاريخ تأسيس كل السوق.']
];

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction','LocalBusiness'],
  '@id': entityId,
  ...(pageUrl ? { url: pageUrl } : {}),
  name: 'سوق المباركية',
  alternateName: ['Souk Al-Mubarakiya','سوق المباركية القديم'],
  description: 'سوق تراثي في قلب مدينة الكويت، يضم شبكة من الأسواق والممرات التقليدية ويرتبط بتاريخ التجارة والحياة اليومية في الكويت القديمة.',
  address,
  geo: { '@type':'GeoCoordinates', latitude: 29.374588243816994, longitude: 47.973118089148905 },
  containedInPlace: { '@type':'City', name:'مدينة الكويت', containedInPlace:{ '@type':'Country', name:'دولة الكويت' } },
  hasMap: 'https://maps.app.goo.gl/Unad47yFEGSrn79r6',
  openingHours: '08:00-22:00',
  aggregateRating: { '@type':'AggregateRating', ratingValue:'4.4', ratingCount:'26505', bestRating:'5' },
  isAccessibleForFree: true,
  sameAs: [
    'https://maps.app.goo.gl/Unad47yFEGSrn79r6',
    'https://www.wikidata.org/wiki/Q7565064'
  ]
};
const webPageSchema = {
  '@context':'https://schema.org',
  '@type':'WebPage',
  ...(pageUrl ? { url: pageUrl } : {}),
  name:'دليل سوق المباركية في مدينة الكويت',
  inLanguage:'ar-KW',
  about:{ '@id': entityId },
  mainEntity:{ '@id': entityId },
  isPartOf:{ '@type':'WebSite', '@id':websiteId, ...(pageUrl ? { url:pageUrl } : {}), name:'دليل سوق المباركية' }
};
const faqSchema = {
  '@context':'https://schema.org', '@type':'FAQPage', mainEntity: faq.map(([q,a]) => ({ '@type':'Question', name:q, acceptedAnswer:{'@type':'Answer',text:a} }))
};

const photos = [
  {
    src:'/images/souk-al-mubarakiya-night.jpg',
    alt:'ممر رئيسي في سوق المباركية ليلًا',
    credit:'تصوير: زيرون — ترخيص المشاع الإبداعي نَسب المصنف 4.0'
  },
  {
    src:'/images/souk-al-mubarakiya-day.jpg',
    alt:'مشهد نهاري من سوق المباركية في مدينة الكويت',
    credit:'تصوير: عزيز1005 — ملكية عامة'
  }
];
---
<BaseLayout
  title="سوق المباركية في مدينة الكويت | التاريخ والزيارة والمواصلات"
  description="دليل غير ربحي وموسّع لسوق المباركية في مدينة الكويت: التاريخ، أوقات الزيارة، الوصول من المطار، المواصلات، المواقف، المرافق، الطعام، المعالم القريبة والأسئلة الشائعة."
  path="/"
  jsonLd={[attractionSchema, webPageSchema, faqSchema]}
>
  <section class="hero geometric">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">مدينة الكويت · القبلة · قلب الأسواق التاريخية</p>
        <h1>سوق المباركية</h1>
        <p class="hero-lead">ممرات مظللة، رائحة البهارات والقهوة، واجهات خشبية، وأسواق متخصصة تحفظ صورة من الحياة التجارية القديمة في الكويت.</p>
        <div class="facts" aria-label="معلومات سريعة">
          <span><b>08:00–22:00</b><small>الساعات الواردة في بيانات الموقع المزوّدة</small></span>
          <span><b>4.4 / 5</b><small>تقييم خرائط متغير بمرور الوقت</small></span>
          <span><b>9XFF+G5</b><small>رمز الموقع في مدينة الكويت</small></span>
        </div>
        <div class="actions"><a class="primary" href="#visit">خطط زيارتك</a><a class="secondary" href="https://maps.app.goo.gl/Unad47yFEGSrn79r6" rel="noopener noreferrer">الاتجاهات على الخريطة</a></div>
      </div>
      <figure class="arch hero-photo">
        <img src={photos[0].src} alt={photos[0].alt} width="960" height="656" loading="eager" fetchpriority="high" />
        <figcaption>{photos[0].credit}</figcaption>
      </figure>
    </div>
  </section>

  <section class="identity-strip">
    <div class="wrap identity-grid">
      <div><small>الاسم</small><strong>سوق المباركية</strong></div>
      <div><small>الموقع</small><strong>المباركية، شارع سوق الغربللي، مدينة الكويت</strong></div>
      <div><small>الإحداثيات</small><strong dir="ltr">29.374588, 47.973118</strong></div>
      <div><small>الطبيعة</small><strong>سوق تراثي ومقصد للزوار</strong></div>
    </div>
  </section>

  <section id="history" class="section">
    <div class="wrap history-grid">
      <div>
        <p class="eyebrow">هوية المكان</p>
        <h2 class="section-title">سوق ليس مبنى واحدًا، بل ذاكرة تجارية متشابكة</h2>
        <p class="lead">تصف المصادر الأكاديمية والرسمية المباركية بوصفها جزءًا من قلب الكويت القديم وشبكة من الأسواق المتخصصة. وتفيد جامعة الكويت بأن أسواق المنطقة تمتد جذورها إلى أكثر من 180 عامًا، مع أكثر من عشرين سوقًا تخصصيًا عُرفت بمهن وسلع مختلفة.</p>
        <div class="timeline">
          <article><b>قبل العصر النفطي</b><p>تشكّلت في المنطقة أسواق للحوم والخضار والحلوى والبشوت والسلاح والمناخ وغيرها، وكانت نقطة تبادل يومية بين أهل المدينة والتجار.</p></article>
          <article><b>1897</b><p>يرتبط هذا العام بكشك الشيخ مبارك الصباح، وهو معلم تاريخي داخل نطاق المباركية. لذلك لا ينبغي استخدام 1897 كتاريخ مبسط لتأسيس السوق كله.</p></article>
          <article><b>1911</b><p>افتُتحت المدرسة المباركية في المنطقة، في دلالة على انتقال قلب المدينة من التجارة وحدها إلى التعليم والحياة العامة المنظمة.</p></article>
          <article><b>نحو 1969–1970</b><p>شهدت المنطقة أعمال تنظيم وتطوير حافظت على طابع الأسواق وممراتها التراثية بدل تحويلها إلى مركز تجاري حديث مغلق.</p></article>
          <article><b>2022 وما بعده</b><p>أصاب حريق جزءًا من أقدم النطاقات التاريخية، ثم أعاد النقاش حول الحماية والترميم أهمية توثيق المباني والهوية العمرانية.</p></article>
        </div>
      </div>
      <div>
        <figure class="arch side-photo"><img src={photos[1].src} alt={photos[1].alt} loading="lazy" width="960" height="720" /><figcaption>{photos[1].credit}</figcaption></figure>
        <aside class="source-note card"><strong>كيف نتحقق من الرواية؟</strong><p>نفرّق بين تاريخ المعالم الفردية وتاريخ شبكة الأسواق، ونقارن بين مصادر حكومية وأكاديمية بدل تكرار تواريخ شائعة بلا سياق.</p></aside>
      </div>
    </div>
  </section>

  <section class="section dark">
    <div class="wrap">
      <p class="eyebrow">قراءة السوق</p><h2 class="section-title">ما الذي ستراه في الممرات؟</h2>
      <div class="market-grid">
        <article><span>01</span><h3>الأسواق المتخصصة</h3><p>تاريخيًا عُرفت أجزاء من المباركية بأسماء مرتبطة بالسلع والحرف، مثل أسواق البشوت والحلوى واللحم والخضار والسلاح والمناخ.</p></article>
        <article><span>02</span><h3>الظل والخشب</h3><p>الممرات المسقوفة والعناصر الخشبية ليست مجرد ديكور؛ إنها استجابة محلية للشمس والحرارة وتمنح السوق هويته العمرانية.</p></article>
        <article><span>03</span><h3>الغذاء والعطر</h3><p>البهارات والتمور والقهوة والعطور والأطعمة المحلية جزء أساسي من التجربة الحسية للمكان، من دون حاجة إلى حصر الزيارة في متجر بعينه.</p></article>
        <article><span>04</span><h3>المعالم المدنية</h3><p>قرب الأسواق توجد شواهد على تاريخ الإدارة والتعليم والحياة العامة، وفي مقدمتها كشك الشيخ مبارك وما تبقى من ذاكرة المدينة القديمة.</p></article>
      </div>
    </div>
  </section>

  <section id="visit" class="section">
    <div class="wrap">
      <p class="eyebrow">خطة عملية</p><h2 class="section-title">قبل أن تذهب</h2>
      <div class="planning-grid">
        <article class="card"><h3>الدخول والتكاليف</h3><p>الدخول إلى منطقة السوق العامة مجاني ولا يتطلب تذكرة. ادفع فقط مقابل المشتريات أو الطعام أو الخدمات التي تختارها. قد تكون بعض المعالم أو الفعاليات منفصلة في قواعدها.</p></article>
        <article class="card"><h3>أفضل وقت</h3><p>تكون الأشهر المعتدلة أكثر راحة للمشي. المساء يمنح أجواء أكثر حيوية وإضاءة، بينما تسمح الزيارة الصباحية عادة باستكشاف أهدأ نسبيًا.</p></article>
        <article class="card"><h3>مدة مقترحة</h3><p>خطط لنحو ساعة ونصف إلى ثلاث ساعات. أضف وقتًا إذا كنت مهتمًا بالتاريخ أو الطعام أو المشي إلى المعالم العامة القريبة.</p></article>
        <article class="card"><h3>الملابس والسلوك</h3><p>اختر ملابس مريحة ومحتشمة وحذاء مناسبًا للمشي. احترم خصوصية الباعة والزوار عند التصوير، واطلب الإذن عند تصوير أشخاص عن قرب.</p></article>
      </div>
    </div>
  </section>

  <section id="transport" class="section sand">
    <div class="wrap">
      <p class="eyebrow">تفاصيل الوصول</p><h2 class="section-title">من المطار، بالحافلة، بسيارة الأجرة أو بالسيارة</h2>
      <div class="transport-grid">
        <article><b>01</b><div><h3>من مطار الكويت الدولي</h3><p>الخيار المباشر هو سيارة أجرة مرخصة من منطقة الوصول إلى وسط مدينة الكويت. تنشر إدارة المطار تعرفة إرشادية للرحلة إلى مدينة الكويت؛ تحقق من السعر المعلن في المطار قبل الركوب لأن التعرفات قد تتغير.</p></div></article>
        <article><b>02</b><div><h3>الحافلات العامة</h3><p>تعرض صفحة النقل الرسمية في المطار خطوطًا عامة من بينها 13 و99 و501. يمر الخط 13 باتجاه مناطق وسطية تشمل المرقاب، ومن هناك يمكن متابعة الطريق سيرًا أو بسيارة أجرة قصيرة. راجع الجدول والمسار في يوم الزيارة.</p></div></article>
        <article><b>03</b><div><h3>سيارات الأجرة</h3><p>استخدم سيارات الأجرة المرخصة أو نقاط الركوب المعروفة، واطلب تطبيق العداد أو السعر النظامي المعمول به. الوصول إلى حافة منطقة السوق غالبًا أسهل من محاولة الدخول إلى الممرات الداخلية.</p></div></article>
        <article><b>04</b><div><h3>بالسيارة الخاصة</h3><p>استهدف مرافق المواقف العامة في نطاق وسط المدينة، ثم أكمل المسافة القصيرة سيرًا. في ساعات المساء والعطلات، اترك هامشًا زمنيًا للبحث عن موقف والخروج من المنطقة.</p></div></article>
      </div>
      <div class="map-frame card"><iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3092.0451984373562!2d47.973118089148905!3d29.374588243816994!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3fcf84e895d75539%3A0xe2081f7936a852b0!2sSouk%20Al-Mubarakiya!5e1!3m2!1szh-CN!2s!4v1788189123289!5m2!1szh-CN!2s" width="600" height="450" style="border:0;" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin" title="خريطة موقع سوق المباركية"></iframe></div>
    </div>
  </section>

  <section id="facilities" class="section">
    <div class="wrap">
      <p class="eyebrow">احتياجات الزائر</p><h2 class="section-title">الخدمات والمرافق حول السوق</h2>
      <p class="lead">نذكر أنواع الخدمات فقط للحفاظ على حياد الدليل وعدم تحويله إلى صفحة إعلانية. توفر الخدمة وساعاتها قد تتغير، لذلك راجع اللافتات المحلية عند الوصول.</p>
      <div class="facility-grid">
        <article><i>🚻</i><h3>دورات المياه</h3><p>خدمات عامة موجودة في نطاق السوق والمرافق المحيطة؛ قد تختلف ساعات الفتح وإمكانية الوصول.</p></article>
        <article><i>🅿️</i><h3>مواقف السيارات</h3><p>مواقف عامة ومتعددة الطوابق في محيط وسط المدينة. الضغط أعلى مساءً وفي العطلات.</p></article>
        <article><i>🍽️</i><h3>الطعام</h3><p>مطاعم شعبية، مشويات، أطباق أرز، مأكولات بحرية، خبز، حلويات وتمور ومقاهي وشاي.</p></article>
        <article><i>🛏️</i><h3>الإقامة</h3><p>فنادق وشقق فندقية بدرجات مختلفة في مركز مدينة الكويت؛ اختر حسب الميزانية وقربك من مسارات النقل.</p></article>
        <article><i>🛒</i><h3>المواد اليومية</h3><p>بقالات وأسواق مواد غذائية وصيدليات وخدمات يومية في النطاق الحضري القريب.</p></article>
        <article><i>⛽</i><h3>الوقود والشحن</h3><p>محطات وقود ونقاط شحن كهربائي موزعة في المدينة؛ تحقق من الخريطة الحية والتوافق قبل الاعتماد على نقطة محددة.</p></article>
      </div>
    </div>
  </section>

  <section class="section dark food">
    <div class="wrap split">
      <div><p class="eyebrow">حول المائدة</p><h2 class="section-title">ماذا تأكل من دون قوائم تجارية؟</h2><p class="lead">تعامل مع المباركية كمنطقة نكهات لا كقائمة مطاعم. ابحث عن الأنواع التي تعبّر عن المطبخ المحلي وتناسب ميزانيتك واحتياجاتك الغذائية.</p></div>
      <div class="chips"><span>أرز ولحوم على الطريقة الكويتية</span><span>مشويات</span><span>مأكولات بحرية</span><span>خبز محلي</span><span>حلويات وتمور</span><span>قهوة وشاي</span><span>بهارات وأعشاب</span></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">في المحيط القريب</p><h2 class="section-title">معالم عامة تكمل قراءة وسط مدينة الكويت</h2>
      <div class="nearby-grid">
        <article class="card"><h3>كشك الشيخ مبارك</h3><p>معلم تاريخي داخل نطاق المباركية يرتبط بالإدارة والحياة العامة في عهد الشيخ مبارك الصباح، وهو أفضل نقطة لفهم سبب ارتباط اسم السوق به.</p></article>
        <article class="card"><h3>المسجد الكبير</h3><p>معلم ديني ومعماري بارز في مركز مدينة الكويت. راعِ أوقات الصلاة ومتطلبات الدخول والملابس عند الزيارة.</p></article>
        <article class="card"><h3>قصر السيف ومحيطه</h3><p>منطقة ذات أهمية سياسية وعمرانية على الواجهة الحضرية القديمة. بعض الأجزاء ليست مرفقًا سياحيًا مفتوحًا، لذلك تُشاهد من الأماكن العامة المسموح بها.</p></article>
        <article class="card"><h3>متحف الكويت الوطني وبيت السدو</h3><p>مؤسسات ثقافية تساعد على وضع السوق ضمن سياق أوسع للحياة البحرية والبدوية والحرفية في الكويت. تحقق من ساعات الزيارة الرسمية مسبقًا.</p></article>
      </div>
    </div>
  </section>

  <section id="faq" class="section sand">
    <div class="wrap faq-wrap">
